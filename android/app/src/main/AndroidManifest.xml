<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <!-- Expiry reminders. Local only: these are scheduled by the phone, for the
         phone. Karde still has no INTERNET permission, so nothing is sent or
         received — the reminder is worked out here and shown here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Reminders were inexact, on the reasoning that arriving at ten past nine
         instead of nine is not worse in any way a user could notice. On this
         phone that turned out to be wrong in a way they very much would: an
         inexact reminder sat undelivered for its whole one-hour window while the
         device was awake, charging, not dozing and the app was in Android's
         active bucket, and then expired without ever being shown.

         SCHEDULE_EXACT_ALARM and not USE_EXACT_ALARM. USE_EXACT_ALARM needs no
         permission dialog but Google reserves it for apps whose *primary*
         purpose is alarms, calendars or clocks; Karde is a vault that happens to
         remind you, so claiming it would be a policy risk. This one is granted
         by the user, in the system's "Alarms & reminders" screen, and Karde asks
         only at the moment somebody turns expiry reminders on. Refusing costs
         only punctuality — the reminders fall back to inexact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Karde's own camera screen, which draws a guide so a card or document
         is framed square instead of at an angle. Asked for at the moment the
         user taps "Take a photo" and never before. Anyone who refuses can still
         use their phone's camera app, which needs no permission from Karde. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Pulled in by the camera plugin and removed again. Karde records no
         audio — the controller is built with enableAudio false — and reads no
         media store: pictures come from the system picker as content URIs,
         which needs no permission at all. Left in place, a vault app would be
         declaring microphone access on the Play listing.
         Verified with: adb shell dumpsys package com.karde.app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <application
        android:label="Karde"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Lets a camera app write a capture into Karde's own cache directory.

             Needed because ACTION_IMAGE_CAPTURE hands the work to whatever camera
             app the user already has, and that app has to be given somewhere to
             put the result. Using a FileProvider rather than declaring the CAMERA
             permission keeps Karde's permission list at USE_BIOMETRIC alone.

             exported="false" with grantUriPermissions means access is handed out
             one URI at a time, for the single file named in the intent, and only
             for as long as that intent is being served. res/xml/file_paths.xml
             restricts it to the captures cache directory — the encrypted photos
             in filesDir are not reachable through it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The two receivers that make a scheduled reminder actually arrive.

             These must be declared here, by the app. From version 16 the
             notifications plugin stopped declaring them in its own manifest and
             now ships only the VIBRATE and POST_NOTIFICATIONS permissions, so
             nothing merges them in and nothing warns that they are missing.

             Without them every reminder was scheduled, accepted, and quietly
             thrown away: the alarm fired on time and Android tried to deliver it
             to a component that did not exist in the package. On the phone that
             looked exactly like a working feature — the alarm was visible in
             `dumpsys alarm`, it disappeared at nine o'clock on the right day —
             and no notification ever appeared. Reminders had never once worked
             in any build.

             ScheduledNotificationBootReceiver is what re-arms everything after
             the phone restarts, which is what RECEIVE_BOOT_COMPLETED is declared
             for; a vault whose reminders die at the next reboot is barely better
             than one with none. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
